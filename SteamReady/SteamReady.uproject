{
  "FileVersion": 3,
  "EngineAssociation": "5.7",
  "Category": "Games",
  "Description": "A multiplayer-ready template with Steam lobby hosting and joining, and built-in accessibility options including audio, video, and control settings.",
  "IsTemplate": true,
  "Modules": [
    {
      "Name": "SteamReady",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "AdditionalDependencies": [
        "Engine",
        "AIModule",
        "UMG",
        "AdvancedSessions"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "ModelingToolsEditorMode",
      "Enabled": true,
      "TargetAllowList": [
        "Editor"
      ]
    },
    {
      "Name": "StateTree",
      "Enabled": true
    },
    {
      "Name": "GameplayStateTree",
      "Enabled": true
    },
    {
      "Name": "OnlineSubsystemSteam",
      "Enabled": true
    },
    {
      "Name": "SocketSubsystemSteamIP",
      "Enabled": true
    },
    {
      "Name": "SocketSubsystemEOS",
      "Enabled": true
    },
    {
      "Name": "SteamSockets",
      "Enabled": true
    }
  ]
}